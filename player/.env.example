DATABASE_URL="file:./dev.db"

# URL publique de base (sitemap, robots, canonicals, OG cards).
# Sans trailing slash. Si vide en prod, on tombe sur https://mon2027.fr.
NEXT_PUBLIC_BASE_URL="https://mon2027.fr"

# Secret HMAC pour signer le cookie defi_client (lien device ↔ clientId
# vérifié serveur). Génère 32+ caractères aléatoires :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si vide, la signature est désactivée : les pages de résultats de défi
# tombent sur le rendu public-only (pas de creatorAnswers détaillés).
DEFI_SIGN_SECRET=""

# Web Push (VAPID) — générer avec `npx web-push generate-vapid-keys`
# La publique est exposée au navigateur, la privée reste serveur.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact technique requis par le protocole Web Push (RFC 8292).
VAPID_SUBJECT="mailto:contact@mon2027.fr"

# Reverse-proxy attendu pour l'extraction de l'IP client réelle.
# Valeurs : "cloudflare" (lit cf-connecting-ip), "xff-last" (dernière IP
# de x-forwarded-for, la plus proche du proxy de confiance), ou "none"
# (mode dev — pas de proxy, on lit n'importe quel header).
# Laisser vide en prod = aucune confiance dans les headers ; le rate-limit
# tombe sur la clé "unknown" et est donc partagé entre tous les clients.
TRUST_PROXY="none"
