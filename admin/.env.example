DATABASE_URL="file:./dev.db"

# Authentification : comptes contributeurs individuels (plus de Basic-Auth).
# Premier compte, en ligne de commande depuis admin/ :
#   $env:DATABASE_URL="file:./dev.db"; node ../scripts/contributor.cjs create <login> superadmin "Ton nom"
# Les anciennes variables ADMIN_USER / ADMIN_PASSWORD ne servent plus.

# Aperçu jouable (« Prévisualiser ») : adresse du player. En production, les
# deux apps partagent le domaine (admin sous /admin) : laisser vide. En local,
# le player tourne sur un autre port :
# PLAYER_URL="https://localhost:2028"
