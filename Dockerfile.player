# syntax=docker/dockerfile:1.6
# Build context : racine du repo Mon2027 (contient prisma/ et player/).

FROM node:22-bookworm-slim AS deps
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY prisma ./prisma
COPY player/package.json player/package-lock.json ./player/
WORKDIR /app/player
RUN npm ci

FROM node:22-bookworm-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
# NEXT_PUBLIC_* sont inlinés au build — il faut les exposer ici pour qu'ils
# arrivent dans le bundle client. La valeur vient du docker-compose (args).
ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
ENV NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY
ARG NEXT_PUBLIC_BASE_URL="https://mon2027.fr"
ENV NEXT_PUBLIC_BASE_URL=$NEXT_PUBLIC_BASE_URL
# Racine du repo : prisma.config.ts pointe ../prisma → Prisma considère /app
# comme root et veut y trouver package.json. On y met le package.json racine.
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY --from=deps /app/player/node_modules ./player/node_modules
COPY player ./player
# Prisma 6 considère /app comme racine projet (prisma.config.ts pointe
# ../prisma/schema.prisma). Sans ces symlinks, il ne trouve pas son binaire
# dans /app/node_modules/ et déclenche un `npm i prisma -D` qui OOM-kill
# sur petit VPS. On expose simplement les modules déjà installés côté player.
RUN mkdir -p /app/node_modules && \
    ln -s /app/player/node_modules/prisma /app/node_modules/prisma && \
    ln -s /app/player/node_modules/@prisma /app/node_modules/@prisma
WORKDIR /app/player
RUN npx prisma generate
# DB temporaire pour le build : sitemap.ts / layout.tsx peuvent lire des
# Question pendant le prerender (page d'accueil, OG cards). On crée la
# DB avec le schema (vide), suffisante pour que les requêtes renvoient [].
# La vraie DB de prod est injectée à runtime via env_file.
RUN DATABASE_URL="file:/tmp/build.db" npx prisma migrate deploy
RUN NODE_ENV=production DATABASE_URL="file:/tmp/build.db" npm run build

FROM node:22-bookworm-slim AS runner
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN groupadd -g 1001 nodejs && useradd -u 1001 -g nodejs -M -s /usr/sbin/nologin nextjs

# Le standalone embarque server.js + node_modules minimal + .next/server.
COPY --from=builder --chown=nextjs:nodejs /app/player/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/player/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/player/public ./public
# Schéma Prisma + binaires utiles pour `migrate deploy` exécuté depuis le container.
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nextjs:nodejs /app/player/node_modules/prisma ./node_modules/prisma
COPY --from=builder --chown=nextjs:nodejs /app/player/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder --chown=nextjs:nodejs /app/player/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=nextjs:nodejs /app/player/prisma.config.ts ./prisma.config.ts

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
